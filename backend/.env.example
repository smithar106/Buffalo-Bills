# LLM provider (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Data providers
SPORTS_DATA_PROVIDER=mock
NEWS_PROVIDER=mock

# Big Balls Data (live sports provider)
BBS_API_KEY=
BBS_BASE_URL=https://api.bigballsdata.com

# Database (local demo uses SQLite; Railway injects a PostgreSQL DATABASE_URL)
DATABASE_URL=sqlite:///./bills_mafia.db

# Observability
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
